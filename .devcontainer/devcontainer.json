{
  "name": "Lean Shim",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bookworm",
  "remoteUser": "node",
  "remoteEnv": {
    "PATH": "/home/node/.elan/bin:${containerEnv:PATH}"
  },
  "hostRequirements": {
    "cpus": 4
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "leanprover.lean4",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "editor.inlineSuggest.enabled": false,
        "workbench.secondarySideBar.defaultVisibility": "hidden",
        "editor.minimap.enabled": false
      }
    }
  },
  "onCreateCommand": "bash .devcontainer/setup.sh",
  "updateContentCommand": "bash .devcontainer/update-content.sh",
  "postStartCommand": "bash .devcontainer/warm-lean.sh",
  "postAttachCommand": "bash .devcontainer/install-extension.sh"
}
